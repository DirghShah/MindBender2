# Copy to .env (which is gitignored) and fill in real values.

# Required. Get one free at https://console.groq.com
GROQ_API_KEY=

# Server bind address. Defaults shown.
BIND_HOST=0.0.0.0
BIND_PORT=8080
LOG_LEVEL=info

# Rate limit (per IP). Defaults: 60 burst, 60 prompts/minute sustained.
# Two iPads on the same school Wi-Fi may share an IP after NAT — bump these
# if a single class hits the cap.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1.0

# Daily token budget across the whole class (resets at UTC midnight, in-memory).
# Groq's free tier is roughly 100,000 tokens/day on Llama 3.3 — match this to
# your actual Groq tier so the proxy refuses extra prompts with a friendly
# message once you hit it instead of letting Groq return an opaque error.
DAILY_TOKEN_BUDGET=100000
